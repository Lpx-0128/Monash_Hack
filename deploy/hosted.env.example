# Copy to /etc/harbor-review.env (0600); never commit actual credentials.
HARBOR_HOSTED=true
BACKEND_MODE=mock
HOST=127.0.0.1
PORT=5173
COOKIE_SECURE=true
MOCK_DATASET_FILE=/var/lib/harbor-review/reference/emails.json
SIMULATOR_STATE_FILE=/var/lib/harbor-review/mock-state.json
HARBOR_AUTH_FILE=/var/lib/harbor-review/auth.json
HARBOR_LINK_SECRET=REPLACE_WITH_RANDOM_64_HEX
F2_BRIDGE_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_64_HEX
F2_BACKEND_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_64_HEX
F2_BACKEND_URL=http://127.0.0.1:5173
F2_BRIDGE_URL=http://127.0.0.1:5175
F2_DASHBOARD_URL=https://REPLACE_WITH_HOSTNAME
F2_STATE_FILE=/var/lib/harbor-review/interaction-mock.json
F2_RECIPIENTS=[]
F2_ACTORS=
TELEGRAM_BOT_USERNAME=REPLACE_WITH_BOT_USERNAME
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_ALLOWED_USERS=0
HERMES_HOME=/var/lib/harbor-review/hermes
F3_ENABLED=true
F3_PROVIDER=azure-foundry
F3_MODEL=harbor-interpretation
F3_DAILY_CALL_LIMIT=200
AZURE_FOUNDRY_BASE_URL=https://REPLACE_WITH_RESOURCE.openai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=REPLACE_WITH_AZURE_KEY
VOICE_ENABLED=false
