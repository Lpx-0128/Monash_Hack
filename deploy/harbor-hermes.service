[Unit]
Description=Harbor Review pinned Hermes Telegram gateway
After=network-online.target harbor-web.service
Wants=network-online.target

[Service]
User=harbor
Group=harbor
WorkingDirectory=/opt/hermes-agent
EnvironmentFile=/etc/harbor-review.env
Environment=HOME=/var/lib/harbor-review
ExecStart=/opt/hermes-agent/.venv/bin/python -m hermes_cli.main gateway run
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/harbor-review

[Install]
WantedBy=multi-user.target
