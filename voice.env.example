# Copy to ignored .local/voice.env and fill locally. Never paste credentials in chat.
# Load AFTER .local/f2.env for both simulator and interaction service.
VOICE_ENABLED=true
# Trial accounts reject optional call-creation fields. The call duration update
# must succeed before authentication/readout; otherwise the service hangs up.
VOICE_PROVIDER_MODE=trial
# Supervised synthetic outbound demo only: trial-demo uses per-step expiring
# bearer URLs plus Telegram authentication. It cannot enforce a phone hangup.
# Requires explicit operator approval of the application deadline / 600s backup.
VOICE_TRIAL_DEMO_ACKNOWLEDGED=false
# Optional supervised synthetic outbound demo: trust whoever answers the enrolled
# handset, without proving their identity through Telegram. Never for real data.
VOICE_DEMO_SKIP_CHALLENGE=false
# Optional incoming trial demo: a separate random 32-byte hexadecimal key.
# Configure the generated one-hour protected /voice/inbound URL in Twilio.
VOICE_INBOUND_ENABLED=false
VOICE_INBOUND_KEY=replace-with-64-random-hex-characters
VOICE_BACKEND_TOKEN=replace-with-a-distinct-random-secret-at-least-32-characters
TWILIO_ACCOUNT_SID=AC_replace_locally
TWILIO_AUTH_TOKEN=replace_locally
TWILIO_FROM=+10000000000
VOICE_PUBLIC_URL=https://replace-with-your-tunnel-origin.example
VOICE_PORT=5177
VOICE_STATE_FILE=.local/voice-state.json
VOICE_CALL_SECONDS=90
# trial-demo can use up to 600 seconds; strict modes remain limited to 180.
VOICE_QUIET_START=22
VOICE_QUIET_END=8
# One existing Telegram actor and explicitly verified handset. False = inbound only.
# Enable only when ready for ONE outbound attempt for this current demo review.
VOICE_ENROLLMENT=[{"actor":"replace-with-enrolled-actor","phone":"+60000000000","optedIn":false,"outboundCaseId":"demo_candidate-choice"}]
