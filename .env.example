# Server only; do not put secrets in VITE_* variables.
PORT=5173
HOST=127.0.0.1
# Set true when hosted behind HTTPS.
COOKIE_SECURE=false
# Build-time / runtime frontend integration settings.
# Set VITE_API_MODE=live to connect React frontend to live backend.
VITE_API_MODE=live
VITE_API_BASE=/api/v1

# Express Gateway Backend Mode: 'real' (proxies /api/v1 to FastAPI) or 'mock' (synthetic demo store)
BACKEND_MODE=real
BACKEND_URL=http://127.0.0.1:8000

# Optional writable single-process demo persistence file (default .local/simulator-state.json)
# SIMULATOR_STATE_FILE=.local/simulator-state.json

# Person A document intelligence — example configuration.
# Copy to .env and fill in real values. Never commit a filled-in copy:
# .gitignore keeps .env and .env.* private, with an exception for this example.

# --- storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./shipping.db

# --- source registries -----------------------------------------------------
# Participant correspondence. Documents here are never demo-safe.
INTELLIGENCE_SOURCE_ROOT=resources/sdoc-hackathon-bundle
# Independently authored fixtures. These are the only publicly streamable sources.
INTELLIGENCE_DEMO_SOURCE_ROOT=resources/demo-fixtures
INTELLIGENCE_ARTIFACT_ROOT=.local/intelligence

# --- identity --------------------------------------------------------------
INTELLIGENCE_CONFIG_VERSION=person-a-v1

# --- numeric interpretation ------------------------------------------------
# How to read a lone separator such as "131,058".
#   auto      (default) use evidence from the document, then from the registry,
#             and otherwise leave the value ambiguous for a person to resolve
#   ambiguous never resolve a lone separator
#   en        ',' groups and '.' is the decimal mark
#   eu        '.' groups and ',' is the decimal mark
# Choosing en or eu is a policy decision with a measured coverage effect;
# docs/person-a-implementation.md records the numbers for both.
INTELLIGENCE_NUMERIC_LOCALE_POLICY=en
# Declare a convention for a registry whose documents are known to use one.
# INTELLIGENCE_SOURCE_NUMERIC_CONVENTION=en
# INTELLIGENCE_DEMO_NUMERIC_CONVENTION=

# --- model adapter ---------------------------------------------------------
# Disabled by default. Deterministic cases work fully without it; a case that
# needs it is reported honestly rather than silently guessed.
INTELLIGENCE_AI_ENABLED=false
INTELLIGENCE_AI_PROVIDER=
INTELLIGENCE_AI_ENDPOINT=
INTELLIGENCE_AI_DEPLOYMENT=
INTELLIGENCE_AI_API_VERSION=
INTELLIGENCE_AI_MODEL=
INTELLIGENCE_AI_API_KEY=
INTELLIGENCE_AI_TIMEOUT_SECONDS=30
INTELLIGENCE_MAX_MODEL_CALLS_PER_RUN=4
# Sending participant documents to an external provider is a shared-contract
# gate, not something read access to this repository implies.
INTELLIGENCE_AI_ALLOW_PARTICIPANT_CONTENT=false

# --- not implemented -------------------------------------------------------
# Setting this true fails fast: no OCR engine is wired up, and an image-only
# document is reported as an honest readability limit instead.
INTELLIGENCE_OCR_ENABLED=false
# Semantic equivalence stays off: it must never decide numeric equality or make
# distinct ports or companies equivalent because they look similar.
INTELLIGENCE_SEMANTIC_EQUIVALENCE_ENABLED=false
